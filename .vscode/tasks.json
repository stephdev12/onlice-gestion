{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Read CEO signup logs",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"read-convex-logs.ps1"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Read password signup failure",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"read-convex-logs.ps1"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Read Convex auth configuration error",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"read-convex-logs.ps1"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Configure Convex Auth production",
			"type": "shell",
			"command": "C:\\Program Files\\nodejs\\node.exe",
			"args": [
				"setup-convex-auth.mjs"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Deploy Convex Auth provider",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"deploy-auth-config.ps1"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Convex dev once",
			"type": "shell",
			"command": "C:\\Program Files\\nodejs\\node.exe",
			"args": [
				".\\node_modules\\convex\\bin\\main.js",
				"dev",
				"--once"
			],
			"group": "build"
		},
		{
			"label": "Next.js production build",
			"type": "shell",
			"command": "cmd /c npm run build",
			"isBackground": false
		},
		{
			"label": "Clean tasks.json and amend before push",
			"type": "shell",
			"command": "Remove-Item -Force tasks_diff.txt -ErrorAction SilentlyContinue; git add -A; git commit --amend --no-edit; git log --oneline -1",
			"isBackground": false
		}
	]
}